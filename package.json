{
  "name": "boundary-bench",
  "version": "0.2.0",
  "description": "A stdio MCP server that tests whether an AI agent respects prompt-injection, budget, approval and stop boundaries, and records what it did.",
  "type": "module",
  "private": true,
  "bin": {
    "boundary-bench": "./dist/cli.js"
  },
  "exports": {
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./evaluator": {
      "types": "./dist/core/evaluator.d.ts",
      "default": "./dist/core/evaluator.js"
    },
    "./scenarios": {
      "types": "./dist/core/scenarios.d.ts",
      "default": "./dist/core/scenarios.js"
    },
    "./agentdojo": {
      "types": "./dist/core/agentdojo.d.ts",
      "default": "./dist/core/agentdojo.js"
    },
    "./types": {
      "types": "./dist/core/types.d.ts"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "dev": "vite",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint . --max-warnings=0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run format && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^24.19.2",
    "eslint": "^9.32.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  }
}
