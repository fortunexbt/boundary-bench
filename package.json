{
  "name": "boundary-bench",
  "version": "0.1.0",
  "description": "Deterministic control-plane benchmark for agent safety, utility, stops, budgets, and evidence integrity.",
  "type": "module",
  "private": true,
  "bin": {
    "boundary-bench": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "benchmark": "tsx src/cli.ts run --candidate all --out site/public/results/latest.json",
    "benchmark:verify": "tsx src/cli.ts verify site/public/results/latest.json",
    "build": "npm run benchmark && tsc -p tsconfig.build.json && vite build",
    "dev": "vite",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint . --max-warnings=0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run format && npm run lint && npm run typecheck && npm test && npm run benchmark:verify && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.32.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.0.6",
    "vitest": "^5.0.3"
  }
}
